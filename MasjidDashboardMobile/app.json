{
  "expo": {
    "name": "Masjid Dashboard",
    "slug": "MasjidDashboardMobile",
    "version": "5.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "masjiddashboardmobile",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0c274b",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "buildNumber": "50",
      "bundleIdentifier": "org.reactjs.native.example.MasjidDashboardMobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0c274b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "versionCode": 50,
      "predictiveBackGestureEnabled": false,
      "package": "com.masjiddashboardmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon_96x96.png",
          "color": "#0c274b"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c274b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8512d270-67a1-4fb7-ade1-49f1d7646604"
      }
    },
    "owner": "sherazc"
  }
}
